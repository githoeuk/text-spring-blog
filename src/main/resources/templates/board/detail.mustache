{{>layout/header}}

<div class="flex-grow-1">

    <section class="position-relative"
             style="
                     min-height: 360px;
                     background:
                     linear-gradient(135deg, rgba(23,19,63,0.90), rgba(75,44,131,0.74), rgba(255,93,162,0.42)),
                     url('https://picsum.photos/seed/detail{{board.id}}/1600/800');
                     background-size: cover;
                     background-position: center;
                     ">

        <div class="container py-5">
            <div class="row align-items-end py-5">
                <div class="col-lg-8 text-white">
                    <div class="mb-3"
                         style="color:#ffd166; font-weight:800; letter-spacing:3px; font-size:14px;">
                        CITY POP DETAIL
                    </div>

                    <h1 class="display-5 fw-bold mb-3">
                        {{board.title}}
                    </h1>

                    <div style="color:rgba(255,255,255,0.82);">
                        <i class="fa-regular fa-user me-1"></i>
                        작성자 : {{board.username}}
                    </div>
                </div>

                <div class="col-lg-4 mt-4 mt-lg-0">
                    <div class="d-flex justify-content-lg-end gap-2 flex-wrap">
                        <a href="/"
                           class="btn btn-outline-light rounded-pill px-4">
                            <i class="fa-solid fa-list me-1"></i>
                            목록
                        </a>

                        {{#sessionUser}}
                            <a href="/board/{{board.id}}/update-form"
                               class="btn rounded-pill px-4 fw-bold"
                               style="background:#ffd166; color:#17133f;">
                                수정
                            </a>

                            <form action="/board/{{board.id}}/delete" method="post" class="d-inline">
                                <button type="submit"
                                        class="btn rounded-pill px-4 fw-bold"
                                        style="background:#ff5da2; color:white;"
                                        onclick="return confirm('정말 삭제하시겠습니까?');">
                                    삭제
                                </button>
                            </form>
                        {{/sessionUser}}
                    </div>
                </div>
            </div>
        </div>

    </section>

    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-9">

                <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                    <div class="card-body p-4 p-md-5">

                        <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                            <div>
                                <span class="badge rounded-pill px-3 py-2"
                                      style="background:#ffd166; color:#17133f;">
                                    RETRO POST
                                </span>
                            </div>

                            <div style="color:#ff5da2; font-weight:800; font-size:14px;">
                                SUNSET · NEON · BLOG
                            </div>
                        </div>

                        <article style="font-size:17px; line-height:1.95; color:#27223f; white-space:pre-line;">
                            {{board.content}}
                        </article>

                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4 mt-4 overflow-hidden">
                    <div class="card-header p-4 text-white"
                         style="background:linear-gradient(135deg, #17133f, #4b2c83, #ff5da2);">
                        <div class="d-flex justify-content-between align-items-center">
                            <b>
                                <i class="fa-regular fa-comments me-1"></i>
                                댓글
                            </b>
                            <span style="color:#ffd166; font-size:13px; font-weight:800;">
                                COMING SOON
                            </span>
                        </div>
                    </div>

                    <div class="card-body p-4">
                        <form action="/reply/save" method="post">
                            <textarea class="form-control rounded-3"
                                      rows="3"
                                      name="comment"
                                      placeholder="댓글 기능은 향후 구현 예정입니다."></textarea>

                            <div class="d-flex justify-content-end mt-3">
                                <button type="submit"
                                        class="btn rounded-pill px-4 fw-bold"
                                        style="background:#ffd166; color:#17133f;">
                                    댓글등록
                                </button>
                            </div>
                        </form>
                    </div>

                    <div class="list-group list-group-flush">
                        <div class="list-group-item p-3">
                            <div class="d-flex align-items-center">
                                <div class="rounded-circle d-flex align-items-center justify-content-center me-3"
                                     style="width:38px; height:38px; background:#ffd166; color:#17133f; font-weight:800;">
                                    C
                                </div>
                                <div>
                                    <div class="fw-bold">cos</div>
                                    <div class="text-muted">댓글 내용입니다</div>
                                </div>
                            </div>
                        </div>

                        <div class="list-group-item p-3">
                            <div class="d-flex align-items-center">
                                <div class="rounded-circle d-flex align-items-center justify-content-center me-3"
                                     style="width:38px; height:38px; background:#ff5da2; color:white; font-weight:800;">
                                    S
                                </div>
                                <div>
                                    <div class="fw-bold">ssar</div>
                                    <div class="text-muted">댓글 내용입니다</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

</div>

{{>layout/footer}}