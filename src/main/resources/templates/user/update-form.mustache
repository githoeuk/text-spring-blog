{{>layout/header}}

<div class="flex-grow-1">

    <section style="
        min-height: 100%;
        background:
            linear-gradient(135deg, rgba(23,19,63,0.90), rgba(75,44,131,0.64), rgba(77,225,209,0.32)),
            url('https://picsum.photos/seed/citypop-profile/1600/1000');
        background-size: cover;
        background-position: center;
    ">

        <div class="container py-5">
            <div class="row justify-content-center align-items-center py-5">
                <div class="col-lg-6 col-md-9">

                    <div class="text-center text-white mb-4">
                        <div style="color:#ffd166; font-weight:800; letter-spacing:3px; font-size:14px;">
                            PROFILE SETTING
                        </div>

                        <h1 class="fw-bold mt-2">회원정보 수정</h1>

                        <p style="color:rgba(255,255,255,0.82);">
                            계정 정보를 확인하고 비밀번호를 변경할 수 있습니다.
                        </p>
                    </div>

                    <div class="card border-0 shadow-lg rounded-4 overflow-hidden"
                         style="background:rgba(255,255,255,0.92); backdrop-filter:blur(12px);">

                        <div class="card-header p-4 text-white"
                             style="background:linear-gradient(135deg, #17133f, #4b2c83, #ff5da2);">

                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h5 class="fw-bold mb-1">My City Profile</h5>
                                    <div style="color:rgba(255,255,255,0.78); font-size:14px;">
                                        현재는 비밀번호만 변경할 수 있습니다.
                                    </div>
                                </div>

                                <div style="font-size:36px;">🌆</div>
                            </div>
                        </div>

                        <div class="card-body p-4 p-md-5">

                            <div class="p-4 rounded-4 mb-4"
                                 style="background:linear-gradient(135deg, rgba(255,93,162,0.12), rgba(77,225,209,0.16)); border:1px solid rgba(23,19,63,0.08);">

                                <div class="d-flex align-items-center">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center me-3"
                                         style="width:56px; height:56px; background:#ffd166; color:#17133f; font-weight:900; font-size:22px;">
                                        <i class="fa-regular fa-user"></i>
                                    </div>

                                    <div>
                                        <div class="fw-bold" style="font-size:20px;">
                                            {{user.username}}
                                        </div>
                                        <div class="text-muted">
                                            {{user.email}}
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <form action="/user/update" method="post">

                                <div class="mb-4">
                                    <label class="form-label fw-bold">
                                        <i class="fa-regular fa-user me-1" style="color:#ff5da2;"></i>
                                        아이디
                                    </label>

                                    <input type="text"
                                           class="form-control form-control-lg rounded-3 bg-light"
                                           value="{{user.username}}"
                                           disabled>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label fw-bold">
                                        <i class="fa-regular fa-envelope me-1" style="color:#ff5da2;"></i>
                                        이메일
                                    </label>

                                    <input type="email"
                                           class="form-control form-control-lg rounded-3 bg-light"
                                           value="{{user.email}}"
                                           disabled>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label fw-bold">
                                        <i class="fa-solid fa-lock me-1" style="color:#ff5da2;"></i>
                                        새 비밀번호
                                    </label>

                                    <input type="password"
                                           class="form-control form-control-lg rounded-3"
                                           name="password"
                                           placeholder="new password">

                                    <div class="form-text">
                                        비밀번호는 최소 4글자 이상 입력해주세요.
                                    </div>
                                </div>

                                <div class="d-flex gap-2">
                                    <a href="/"
                                       class="btn btn-outline-secondary rounded-pill px-4 flex-fill">
                                        취소
                                    </a>

                                    <button type="submit"
                                            class="btn rounded-pill px-4 fw-bold flex-fill"
                                            style="background:#ffd166; color:#17133f;">
                                        <i class="fa-solid fa-check me-1"></i>
                                        수정 완료
                                    </button>
                                </div>

                            </form>

                        </div>
                    </div>

                </div>
            </div>
        </div>

    </section>

</div>

{{>layout/footer}}