{{>layout/header}}

<div class="container flex-grow-1 py-5">
    <div class="mx-auto" style="max-width: 760px;">

        <div class="p-5 rounded-4 shadow-lg"
             style="background: linear-gradient(135deg, #0f172a, #1f2937); color: white; border: 1px solid rgba(255,255,255,0.12);">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <div style="color:#f5c542; font-weight:700; letter-spacing:2px;">NYC ACCESS GATE</div>
                    <h1 class="display-4 fw-bold mb-0">401</h1>
                </div>
                <div class="text-end">
                    <div style="font-size:42px;">🗽</div>
                    <div style="font-size:13px; color:#adb5bd;">Unauthorized</div>
                </div>
            </div>

            <h3 class="fw-bold mb-3">로그인이 필요한 구역입니다</h3>

            <p class="mb-4" style="color:#d6d6d6; line-height:1.7;">
                이 페이지는 로그인한 사용자만 접근할 수 있습니다.
                마치 뉴욕 지하철 게이트처럼, 먼저 로그인이 필요합니다.
            </p>

            <div class="p-3 rounded-3 mb-4"
                 style="background: rgba(255,255,255,0.08); border-left: 5px solid #f5c542;">
                <div style="font-size:14px; color:#adb5bd;">ERROR MESSAGE</div>
                <div class="fw-semibold">{{msg}}</div>
            </div>

            <div class="d-flex gap-2">
                <a href="/login-form" class="btn btn-warning fw-bold px-4">로그인하기</a>
                <a href="/" class="btn btn-outline-light px-4">메인으로</a>
            </div>
        </div>

    </div>
</div>

{{>layout/footer}}