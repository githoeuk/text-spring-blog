{{>layout/header}}

<div class="flex-grow-1">

    <section style="
            min-height: 100%;
            background:
            linear-gradient(135deg, rgba(23,19,63,0.90), rgba(75,44,131,0.66), rgba(255,93,162,0.38)),
            url('https://picsum.photos/seed/edit-citypop{{board.id}}/1600/1000');
            background-size: cover;
            background-position: center;
            ">

        <div class="container py-5">
            <div class="row justify-content-center py-5">
                <div class="col-lg-8">

                    <div class="text-center text-white mb-4">
                        <div style="color:#ffd166; font-weight:800; letter-spacing:3px; font-size:14px;">
                            EDIT CITY POP NOTE
                        </div>

                        <h1 class="fw-bold mt-2">게시글 수정</h1>

                        <p style="color:rgba(255,255,255,0.82);">
                            작성한 글을 다시 다듬어 더 좋은 기록으로 남겨보세요.
                        </p>
                    </div>

                    <div class="card border-0 shadow-lg rounded-4 overflow-hidden"
                         style="background:rgba(255,255,255,0.92); backdrop-filter:blur(12px);">

                        <div class="card-header p-4 text-white"
                             style="background:linear-gradient(135deg, #17133f, #4b2c83, #ff5da2);">

                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h5 class="fw-bold mb-1">Post Edit Mode</h5>
                                    <div style="color:rgba(255,255,255,0.78); font-size:14px;">
                                        제목과 내용을 수정할 수 있습니다.
                                    </div>
                                </div>

                                <div style="font-size:36px;">💿</div>
                            </div>
                        </div>

                        <div class="card-body p-4 p-md-5">

                            <form action="/board/{{board.id}}/update" method="post">

                                <div class="mb-4">
                                    <label class="form-label fw-bold">
                                        <i class="fa-regular fa-user me-1" style="color:#ff5da2;"></i>
                                        작성자
                                    </label>

                                    <input type="text"
                                           name="username"
                                           class="form-control rounded-3 bg-light"
                                           value="{{board.username}}"
                                           readonly>

                                    <div class="form-text">
                                        작성자는 변경할 수 없습니다.
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label fw-bold">
                                        <i class="fa-solid fa-heading me-1" style="color:#ff5da2;"></i>
                                        제목
                                    </label>

                                    <input type="text"
                                           name="title"
                                           class="form-control form-control-lg rounded-3"
                                           value="{{board.title}}"
                                           placeholder="제목을 입력하세요">
                                </div>

                                <div class="mb-4">
                                    <label class="form-label fw-bold">
                                        <i class="fa-regular fa-file-lines me-1" style="color:#ff5da2;"></i>
                                        내용
                                    </label>

                                    <textarea name="content"
                                              rows="9"
                                              class="form-control rounded-3"
                                              placeholder="내용을 입력하세요.">{{board.content}}</textarea>
                                </div>

                                <div class="d-flex gap-2 justify-content-end">
                                    <a href="/board/{{board.id}}"
                                       class="btn btn-outline-secondary rounded-pill px-4">
                                        취소
                                    </a>

                                    <button type="submit"
                                            class="btn rounded-pill px-4 fw-bold"
                                            style="background:#ffd166; color:#17133f;">
                                        <i class="fa-solid fa-check me-1"></i>
                                        수정 완료
                                    </button>
                                </div>

                            </form>

                        </div>
                    </div>

                </div>
            </div>
        </div>

    </section>

</div>

{{>layout/footer}}