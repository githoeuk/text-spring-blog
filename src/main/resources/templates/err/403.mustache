{{>layout/header}}

<div class="container flex-grow-1 py-5">
    <div class="mx-auto" style="max-width: 760px;">

        <div class="p-5 rounded-4 shadow-lg"
             style="background: linear-gradient(135deg, #111827, #312e1f); color: white; border: 1px solid rgba(255,255,255,0.12);">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <div style="color:#f5c542; font-weight:700; letter-spacing:2px;">MANHATTAN BLOCK</div>
                    <h1 class="display-4 fw-bold mb-0">403</h1>
                </div>
                <div class="text-end">
                    <div style="font-size:42px;">🚧</div>
                    <div style="font-size:13px; color:#adb5bd;">Forbidden</div>
                </div>
            </div>

            <h3 class="fw-bold mb-3">접근 권한이 없습니다</h3>

            <p class="mb-4" style="color:#d6d6d6; line-height:1.7;">
                이 구역은 현재 사용자에게 열려 있지 않습니다.
                작성자 본인만 수정하거나 삭제할 수 있는 페이지일 수 있습니다.
            </p>

            <div class="p-3 rounded-3 mb-4"
                 style="background: rgba(255,255,255,0.08); border-left: 5px solid #f5c542;">
                <div style="font-size:14px; color:#adb5bd;">ERROR MESSAGE</div>
                <div class="fw-semibold">{{msg}}</div>
            </div>

            <div class="d-flex gap-2">
                <a href="javascript:history.back()" class="btn btn-warning fw-bold px-4">이전 페이지</a>
                <a href="/" class="btn btn-outline-light px-4">메인으로</a>
            </div>
        </div>

    </div>
</div>

{{>layout/footer}}