{{>layout/header}}

<div class="flex-grow-1">

    <section style="
        min-height: 100%;
        background:
            linear-gradient(135deg, rgba(23,19,63,0.88), rgba(255,93,162,0.55), rgba(77,225,209,0.25)),
            url('https://picsum.photos/seed/write-citypop/1600/1000');
        background-size: cover;
        background-position: center;
    ">

        <div class="container py-5">
            <div class="row justify-content-center py-5">
                <div class="col-lg-8">

                    <div class="text-center text-white mb-4">
                        <div style="color:#ffd166; font-weight:800; letter-spacing:3px; font-size:14px;">
                            WRITE CITY POP NOTE
                        </div>

                        <h1 class="fw-bold mt-2">새 글 작성</h1>

                        <p style="color:rgba(255,255,255,0.82);">
                            노을진 도시의 장면처럼 오늘의 생각을 기록해보세요.
                        </p>
                    </div>

                    <div class="card border-0 shadow-lg rounded-4 overflow-hidden"
                         style="background:rgba(255,255,255,0.92); backdrop-filter:blur(12px);">

                        <div class="card-header p-4 text-white"
                             style="background:linear-gradient(135deg, #17133f, #4b2c83, #ff5da2);">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h5 class="fw-bold mb-1">Post Editor</h5>
                                    <div style="color:rgba(255,255,255,0.78); font-size:14px;">
                                        제목과 내용을 입력한 뒤 등록하세요.
                                    </div>
                                </div>

                                <div style="font-size:36px;">🎹</div>
                            </div>
                        </div>

                        <div class="card-body p-4 p-md-5">
                            <form action="/board/save" method="post">

                                <div class="mb-4">
                                    <label class="form-label fw-bold">
                                        <i class="fa-solid fa-heading me-1" style="color:#ff5da2;"></i>
                                        제목
                                    </label>

                                    <input type="text"
                                           name="title"
                                           class="form-control form-control-lg rounded-3"
                                           placeholder="예) 오늘의 시티팝 기록">
                                </div>

                                <div class="mb-4">
                                    <label class="form-label fw-bold">
                                        <i class="fa-regular fa-file-lines me-1" style="color:#ff5da2;"></i>
                                        내용
                                    </label>

                                    <textarea name="content"
                                              rows="9"
                                              class="form-control rounded-3"
                                              placeholder="내용을 입력하세요."></textarea>
                                </div>

                                <div class="d-flex gap-2 justify-content-end">
                                    <a href="/"
                                       class="btn btn-outline-secondary rounded-pill px-4">
                                        취소
                                    </a>

                                    <button type="submit"
                                            class="btn rounded-pill px-4 fw-bold"
                                            style="background:#ffd166; color:#17133f;">
                                        <i class="fa-solid fa-paper-plane me-1"></i>
                                        글쓰기 완료
                                    </button>
                                </div>

                            </form>
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </section>

</div>

{{>layout/footer}}